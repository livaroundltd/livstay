    "LivstayTerms": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "action": {
          "enum": [
            "book",
            "change",
            "cancel"
          ]
        },
        "quote_id": {
          "type": "string"
        },
        "quote_signature": {
          "type": "string"
        },
        "home_id": {
          "type": "string"
        },
        "check_in": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "check_out": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "party": {
          "$ref": "#/$defs/Party"
        },
        "total": {
          "$ref": "#/$defs/Money"
        },
        "due_now": {
          "$ref": "#/$defs/Money"
        },
        "deposit": {
          "type": "object",
          "properties": {
            "amount": {
              "$ref": "#/$defs/Money"
            },
            "mode": {
              "enum": [
                "none",
                "authorise",
                "hold"
              ]
            }
          },
          "required": [
            "amount",
            "mode"
          ]
        },
        "terms_version": {
          "type": "integer",
          "minimum": 0
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "requirements": {
          "type": "array",
          "items": {
            "enum": [
              "payment",
              "identity_verification"
            ]
          },
          "uniqueItems": true
        },
        "awaiting": {
          "enum": [
            "traveller",
            "host"
          ]
        },
        "proposed_by": {
          "enum": [
            "traveller_agent",
            "host",
            "host_agent"
          ]
        },
        "reason": {
          "type": "string"
        },
        "counter_no": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "price_difference": {
          "$ref": "#/$defs/Money"
        },
        "refund": {
          "$ref": "#/$defs/Money"
        }
      },
      "required": [
        "revision",
        "action",
        "home_id",
        "check_in",
        "check_out",
        "party",
        "terms_version",
        "awaiting",
        "proposed_by"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "book",
                  "change"
                ]
              }
            }
          },
          "then": {
            "required": [
              "quote_id",
              "quote_signature",
              "total",
              "due_now",
              "requirements"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "book"
              }
            }
          },
          "then": {
            "required": [
              "deposit",
              "tier"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "change"
              }
            }
          },
          "then": {
            "required": [
              "price_difference"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "cancel"
              }
            }
          },
          "then": {
            "required": [
              "refund"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "proposed_by": {
                "const": "host_agent"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },

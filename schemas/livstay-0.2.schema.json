        "iss",
        "revision",
        "receipt_id",
        "action",
        "initiated_by",
        "sub",
        "iat"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "propose",
                  "confirm",
                  "counter",
                  "change",
                  "cancel"
                ]
              }
            }
          },
          "then": {
            "required": [
              "operation_id",
              "revision_no",
              "terms_hash",
              "confirmed",
              "approved_by"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "confirmed": {
                "const": false
              }
            },
            "required": [
              "confirmed"
            ]
          },
          "then": {
            "properties": {
              "approved_by": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "initiated_by": {
                "const": "traveller_agent"
              }
            }
          },
          "then": {
            "required": [
              "client_id",
              "scopes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "payment_received",
                  "refund_issued",
                  "deposit_authorised",
                  "deposit_captured",
                  "deposit_released"
                ]
              }
            }
          },
          "then": {
            "required": [
              "amount",
              "reference",
              "event_id"
            ]
          }
        }
      ]
